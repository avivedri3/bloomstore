{
  "name": "@bloomstore/workspace",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "BloomStore — Nx monorepo flower shop e-commerce (ORT diploma project)",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npx nx serve frontend",
    "dev:backend": "npx nx serve backend",
    "build": "npx nx run-many --target=build --projects=frontend,backend,shared-types",
    "build:frontend": "npx nx build frontend",
    "build:backend": "npx nx build backend",
    "test": "npx nx run-many --target=test --projects=frontend,backend,shared-types --passWithNoTests",
    "lint": "npx nx run-many --target=lint --projects=frontend,backend,shared-types",
    "typecheck": "npx nx run-many --target=typecheck --projects=frontend,backend,shared-types",
    "graph": "npx nx graph",
    "affected": "npx nx affected"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
