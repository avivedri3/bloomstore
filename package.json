    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.4.0",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "mongoose": "^8.19.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "reflect-metadata": "^0.2.2",
