{
  "name": "@bloomstore/backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/backend",
        "main": "apps/backend/src/main.ts",
        "tsConfig": "apps/backend/tsconfig.app.json",
        "webpackConfig": "apps/backend/webpack.config.js",
        "assets": ["apps/backend/src/assets"]
      },
      "configurations": {
        "local": { "optimization": false, "extractLicenses": false, "sourceMap": true, "watch": true },
        "development": { "optimization": false, "extractLicenses": false, "sourceMap": true },
        "production": { "optimization": true, "extractLicenses": true, "sourceMap": false }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "local",
      "options": {
        "buildTarget": "@bloomstore/backend:build:local",
        "watch": true,
        "runBuildTargetDependencies": true
      },
      "configurations": {
        "local": { "buildTarget": "@bloomstore/backend:build:local", "watch": true },
        "production": { "buildTarget": "@bloomstore/backend:build:production", "watch": false }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/backend"],
      "options": {
        "command": "node --experimental-strip-types --test apps/backend/src/common/http.spec.ts"
      }
    },
    "lint": { "executor": "@nx/eslint:lint" },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/backend/tsconfig.app.json"
      }
    }
  }
}
